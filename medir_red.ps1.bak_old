# ============================================================
#  MEDICION RED + SISTEMA para equipos remotos por AnyDesk
#  CRM con llamadas IP -> evaluar si el equipo es apto.
#
#  Uso manual:   powershell -NoProfile -ExecutionPolicy Bypass -File medir_red.ps1
#  Uso doble clic: medir.bat (incluido)
#
#  Descarga el speedtest.exe (Ookla CLI) en la primera ejecucion.
# ============================================================
$ErrorActionPreference = 'Stop'

# ---- Umbrales editables (VoIP / CRM) ----
$ThrPing    = 100   # ms  latencia aceptable
$ThrJitter  = 30    # ms  jitter aceptable
$ThrLoss    = 1     # %   perdida de paquetes
$ThrUp      = 1     # Mbps minimo de subida para softphone
$ThrRamMin  = 4     # GB minimo
$ThrRamOpt  = 8     # GB recomendado

function To-Mbps([double]$bytesPerSec) {
    if ($null -eq $bytesPerSec) { return 0 }
    return [math]::Round($bytesPerSec * 8 / 1000000, 1)
}

# ---- 1) Asegurar el CLI de speedtest ----
$scriptDir = $PSScriptRoot
$st = Join-Path $scriptDir 'speedtest.exe'
if (-not (Test-Path $st)) {
    Write-Host '[+] Descargando speedtest.exe (Ookla CLI)...' -NoNewline
    $zip = Join-Path $env:TEMP 'ookla-speedtest.zip'
    Invoke-WebRequest -Uri 'https://install.speedtest.net/app/cli/ookla-speedtest-1.2.0-win64.zip' -OutFile $zip
    $dst = Join-Path $env:TEMP 'ookla-cli'
    if (Test-Path $dst) { Remove-Item $dst -Recurse -Force }
    Expand-Archive -Path $zip -DestinationPath $dst -Force
    $found = Get-ChildItem $dst -Recurse -Filter 'speedtest.exe' | Select-Object -First 1
    if (-not $found) { Write-Host ' ERROR: no se encontro speedtest.exe tras la descarga.'; exit 1 }
    Copy-Item $found.FullName $st -Force
    Write-Host ' listo.'
}

# ---- 2) Medir velocidad (ping, jitter, perdida, bajada, subida) ----
Write-Host '[+] Midiendo velocidad (tarda unos 15-20s)...'
$raw = (& $st --accept-license --accept-gdpr --format json 2>$null | Out-String)
if (-not $raw) { Write-Host 'ERROR: speedtest no devolvio datos.'; exit 1 }
$r = $raw | ConvertFrom-Json

$ping    = $r.ping.latency
$jitter  = $r.ping.jitter
$downM   = To-Mbps $r.download.bandwidth
$upM     = To-Mbps $r.upload.bandwidth
$loss    = $r.packetLoss; if ($null -eq $loss) { $loss = 0 }
$isp     = $r.isp
$serverTxt = "$($r.server.name) - $($r.server.location), $($r.server.country)"

# ---- 3) Sistema ----
$os    = Get-CimInstance Win32_OperatingSystem
$cpu   = Get-CimInstance Win32_Processor | Select-Object -First 1
$cores = $cpu.NumberOfCores; if (-not $cores) { $cores = $cpu.NumberOfLogicalProcessors }
$cpuLoad = (Get-CimInstance Win32_Processor | Measure-Object -Property LoadPercentage -Average).Average
if ($null -eq $cpuLoad) { $cpuLoad = 0 }
$cpuLoad = [math]::Round($cpuLoad, 0)
$ramTotal = [math]::Round($os.TotalVisibleMemorySize / 1MB, 1)
$ramFree  = [math]::Round($os.FreePhysicalMemory / 1MB, 1)
$ramPct   = [math]::Round(($ramTotal - $ramFree) / $ramTotal * 100, 0)
$upHours  = [math]::Round(((Get-Date) - $os.LastBootUpTime).TotalHours, 0)

$disk = Get-CimInstance Win32_LogicalDisk -Filter 'DriveType=3' | Sort-Object Size -Descending | Select-Object -First 1
$diskSizeGB = [math]::Round($disk.Size / 1GB, 0)
$diskFreeGB = [math]::Round($disk.FreeSpace / 1GB, 0)
$diskPct    = [math]::Round(($disk.Size - $disk.FreeSpace) / $disk.Size * 100, 0)

$mediaType = 'N/A'
try { $pd = Get-PhysicalDisk | Select-Object -First 1; $mediaType = $pd.MediaType } catch { $mediaType = 'No determin.' }

$top = Get-Process | Sort-Object CPU -Descending | Select-Object -First 5 |
    ForEach-Object { "      {0,-28} CPU={1,7:N0}s   Mem={2,6:N0} MB" -f $_.ProcessName, $_.CPU, [math]::Round($_.WS / 1MB) }

# ---- 4) Veredicto (umbrales VoIP) ----
$checks = @()
if ($ping   -lt $ThrPing)   { $checks += 'Ping OK'          } else { $checks += 'Ping ALTO' }
if ($jitter -lt $ThrJitter) { $checks += 'Jitter OK'        } else { $checks += 'Jitter ALTO' }
if ($loss   -lt $ThrLoss)   { $checks += 'Perdida OK'       } else { $checks += 'Perdida ALTA' }
if ($upM    -ge $ThrUp)     { $checks += 'Subida OK'        } else { $checks += 'Subida BAJA' }
if ($ramTotal -ge $ThrRamOpt) { $checks += 'RAM OK' }
elseif ($ramTotal -ge $ThrRamMin) { $checks += 'RAM MINIMO' }
else { $checks += 'RAM BAJA' }
$warn = ($checks | Where-Object { $_ -match 'ALTO|ALTA|BAJA|MINIMO' }).Count
if ($warn -eq 0) { $verdict = 'OK';        $color = 'Green' }
elseif ($warn -eq 1) { $verdict = 'RIESGO'; $color = 'Yellow' }
else { $verdict = 'NO OPTIMO'; $color = 'Red' }

# ---- 5) Reporte en pantalla ----
$line = '=' * 78
Write-Host $line
Write-Host "  MEDICION RED/SISTEMA - Equipo: $env:COMPUTERNAME   Fecha: $(Get-Date -Format 'yyyy-MM-dd HH:mm')"
Write-Host $line
Write-Host " :: RED (Ookla Speedtest)          ISP: $isp"
Write-Host ("   Ping    : {0,6} ms"      -f $ping)
Write-Host ("   Jitter  : {0,6} ms"      -f $jitter)
Write-Host ("   Perdida : {0,6} %"       -f $loss)
Write-Host ("   Bajada  : {0,6} Mbps"    -f $downM)
Write-Host ("   Subida  : {0,6} Mbps"    -f $upM)
Write-Host "   Servidor: $serverTxt"
Write-Host ''
Write-Host ' :: SISTEMA'
Write-Host ("   CPU     : {0}  ({1} nucleos, uso {2}%)" -f $cpu.Name, $cores, $cpuLoad)
Write-Host ("   RAM     : {0} GB total - libre {1} GB (uso {2}%)" -f $ramTotal, $ramFree, $ramPct)
Write-Host ("   Disco   : {0} GB, libre {1} GB ({2}% usado) [{3}]" -f $diskSizeGB, $diskFreeGB, $diskPct, $mediaType)
Write-Host ("   Uptime  : {0} horas" -f $upHours)
Write-Host ''
Write-Host ' :: PROCESOS TOP (CPU)'
$top | ForEach-Object { Write-Host $_ }
Write-Host ''
Write-Host "<{0}>" -f ($checks -join ' | ')
Write-Host ''
Write-Host "  >>>  VEREDICTO: $verdict  <<<" -ForegroundColor $color
Write-Host $line

# ---- 6) Guardar registro por equipo/fecha ----
$logDir = Join-Path $scriptDir 'registros'
if (-not (Test-Path $logDir)) { New-Item -ItemType Directory -Path $logDir | Out-Null }
$logFile = Join-Path $logDir ("{0}_{1}.txt" -f $env:COMPUTERNAME, (Get-Date -Format 'yyyyMMdd_HHmm'))
@"
MEDICION EQUIPO: $env:COMPUTERNAME  ($env:USERDOMAIN\$env:USERNAME)
Fecha: $(Get-Date -Format 'yyyy-MM-dd HH:mm')
========================================
RED    ping=$ping ms  jitter=$jitter ms  perdida=$loss%  bajada=$downM Mbps  subida=$upM Mbps
ISP    $isp
SERVIDOR $serverTxt
CPU    $($cpu.Name) | $cores nucleos | uso $cpuLoad%
RAM    $ramTotal GB total | libre $ramFree GB | uso $ramPct%
DISCO  $diskSizeGB GB | libre $diskFreeGB GB | uso $diskPct% | $mediaType
UPTIME $upHours horas
CHECKS $($checks -join ' | ')
VEREDICTO $verdict
========================================
"@ | Set-Content -Path $logFile -Encoding UTF8
Write-Host ''
Write-Host "[+] Registro guardado: $logFile"
